# ─── Core Settings ───────────────────────────
SESSION_ID=
PREFIX=.
BOT_NAME=✦ ShadowBot ✦
DESCRIPTION=*© ✦ ShadowBot ✦*

# ─── Owner Settings ──────────────────────────
OWNER_NAME=✦ ShadowBot ✦
OWNER_NUMBER=254759704347

# ─── Alive Settings ──────────────────────────
LIVE_MSG=> ShadowBot IS ACTIVE ⚡

# ─── Reaction Settings ───────────────────────
AUTO_STATUS_REACT=true
CUSTOM_REACT_EMOJIS=💝,💖,💗,❤️‍🔥,❤️‍🩹,❤️,🩷,🧡,💛,💚,💙,🩵,💜,🤎,🖤,🩶,🤍
AUTO_REACT_NEWSLETTER=true
AUTO_FOLLOW_NEWSLETTER=false
DELETE_LINKS=false

# ─── Anti Features ───────────────────────────
ANTI_BAD=false
ANTIDELETE_GROUP=true
ANTIDELETE_PRIVATE=true

# ─── Status Settings ─────────────────────────
AUTO_STATUS_SEEN=true
AUTO_STATUS_REPLY=true
AUTO_STATUS_MSG=*👀 Seen by ShadowBot ✅*

# ─── Mode Settings ───────────────────────────
MODE=both
ALWAYS_ONLINE=true

# ─── Simulation Settings ─────────────────────
AUTO_TYPING=true
AUTO_RECORDING=false
READ_MESSAGE=false

# ─── Dashboard Settings ──────────────────────
# GitHub Personal Access Token for the admin dashboard (read:public_repo scope).
# Never put this in client-side code — set it here and the server proxies all GitHub API calls.
GITHUB_TOKEN=

# ─── Debug Settings ──────────────────────────
DEBUG=true
