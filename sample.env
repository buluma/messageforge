# ─── Core Settings ───────────────────────────
SESSION_ID=
PREFIX=.
BOT_NAME=✦ MessageForge ✦
DESCRIPTION=*© ✦ MessageForge ✦*

# ─── Owner Settings ──────────────────────────
OWNER_NAME=✦ SHADOWNET ✦
OWNER_NUMBER=254759704347

# ─── Alive Settings ──────────────────────────
LIVE_MSG=> MessageForge IS ACTIVE ⚡

# ─── Reaction Settings ───────────────────────
AUTO_STATUS_REACT=true
CUSTOM_REACT_EMOJIS=💝,💖,💗,❤️‍🔥,❤️‍🩹,❤️,🩷,🧡,💛,💚,💙,🩵,💜,🤎,🖤,🩶,🤍
AUTO_REACT_NEWSLETTER=true
AUTO_FOLLOW_NEWSLETTER=false
AUTO_UNFOLLOW_NEWSLETTER=false
DELETE_LINKS=false

# ─── Anti Features ───────────────────────────
ANTI_BAD=false
ANTIDELETE_GROUP=true
ANTIDELETE_PRIVATE=true
ANTIVV=true
# Max Anti-ViewOnce media size in bytes (default: 64MB)
ANTIVV_MAX_BYTES=67108864
# Max queued Anti-ViewOnce forwards waiting to run
ANTIVV_QUEUE_LIMIT=30

# ─── Status Settings ─────────────────────────
AUTO_STATUS_SEEN=true
AUTO_STATUS_REPLY=true
AUTO_STATUS_MSG=*👀 Seen by MessageForge ✅*
# Status automation mode:
# - "all" (default): view/react/reply to ALL statuses
# - "favorites": only view/react/reply to favorite contacts' statuses
AUTO_STATUS_MODE=all
# Route saved status updates to one chat:
# - set to "owner" for OWNER_NUMBER
# - leave empty or set to "me" for your own chat
# - set phone digits (e.g. 2547xxxxxxx) or full JID (e.g. 2547xxxxxxx@s.whatsapp.net / 1234567890-123456@g.us)
STATUS_INBOX_JID=me

# ─── Mode Settings ───────────────────────────
MODE=both
ALWAYS_ONLINE=true

# ─── Simulation Settings ─────────────────────
AUTO_TYPING=true
AUTO_RECORDING=false
READ_MESSAGE=false

# ─── Dashboard Settings ──────────────────────
# GitHub Personal Access Token for the admin dashboard (read:public_repo scope).
# Never put this in client-side code — set it here and the server proxies all GitHub API calls.
GITHUB_TOKEN=

# ─── AI Provider Settings (Primary + Fallback) ────────────────────────────────
# Primary: OpenRouter
OPENROUTER_API_KEY=
# Optional single model override (example: openai/gpt-4o-mini)
OPENROUTER_MODEL=
# Optional model list fallback order (comma-separated, overrides OPENROUTER_MODEL)
# OPENROUTER_MODELS=openai/gpt-4o-mini,meta-llama/llama-3.3-8b-instruct:free
OPENROUTER_MODELS=

# Fallback: local Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Use a local model name (example: run `ollama pull llama3.2` first)
OLLAMA_MODEL=llama3.2

# Shared AI request timeout in milliseconds
AI_TIMEOUT_MS=25000

# Dashboard access token (required for remote dashboard/API/socket access).
# Example: openssl rand -hex 24
DASHBOARD_TOKEN=

# ─── Database Settings ────────────────────────────────────────────────────────
# Database backend: 'local' (default JSON) or 'postgres'
DATABASE_TYPE=local

# PostgreSQL Configuration (used when DATABASE_TYPE=postgres)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=shadowwalker
POSTGRES_PASSWORD=
POSTGRES_DB=messageforge

# Persistent messenger history limit per chat (used by dashboard pagination)
MESSENGER_HISTORY_MAX=3000

# ─── Debug Settings ──────────────────────────
DEBUG=true
