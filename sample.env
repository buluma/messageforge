# MessageForge sample.env
# This file should list keys only (no secrets, no values) and serve as the canonical
# env contract for local/prod deployments.

# ─── Core Settings ───────────────────────────
SESSION_ID=
PAIRING_CODE=
PAIRING_NUMBER=
PREFIX=
BOT_NAME=
OWNER_NUMBER=
OWNER_NAME=
DESCRIPTION=
LIVE_MSG=
MODE=
THEME=
GREETING=
APP_URL=

# ─── Status Automation ───────────────────────
AUTO_STATUS_SEEN=
AUTO_STATUS_REACT=
AUTO_STATUS_REPLY=
AUTO_STATUS_MSG=
AUTO_STATUS_MODE=
CUSTOM_REACT_EMOJIS=

# Back-compat key: config reads `Status_Saver` or `STATUS_SAVER`
STATUS_SAVER=
STATUS_INBOX_JID=
STATUS_REPLY=
STATUS_MSG=

# ─── Reading / Presence Simulation ───────────
READ_MESSAGE=
ALWAYS_ONLINE=
AUTO_TYPING=
AUTO_RECORDING=

# ─── Newsletter Reactions ────────────────────
AUTO_REACT_NEWSLETTER=
AUTO_FOLLOW_NEWSLETTER=
AUTO_UNFOLLOW_NEWSLETTER=
NEWSLETTER_JID=

# ─── Anti Features ───────────────────────────
ANTI_BAD=
DELETE_LINKS=
ANTILINK=
ANTIDELETE_GROUP=
ANTIDELETE_PRIVATE=
ANTIVV=
ANTIVV_MAX_BYTES=
ANTIVV_QUEUE_LIMIT=

# ─── AI Provider Settings ────────────────────
TENOR_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_MODELS=
OLLAMA_BASE_URL=
OLLAMA_MODEL=
AI_TIMEOUT_MS=

# ─── Dashboard / Admin ───────────────────────
# Required when NODE_ENV=production (Docker deploys). Use a long random string.
DASHBOARD_TOKEN=

# Used by dashboard stats proxy + uploader plugin (GitHub CDN uploads)
GITHUB_TOKEN=
GITHUB_REPO=

# ─── Database Settings ───────────────────────
DATABASE_TYPE=
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
MESSENGER_HISTORY_MAX=

# ─── Logging Controls ────────────────────────
LOG_MAX_FILE_BYTES=
LOG_MAX_AGE_DAYS=
LOG_MAX_TOTAL_BYTES=

# ─── Debug / Strictness ──────────────────────
DEBUG=
STRICT_COMMAND_COLLISIONS=

# ─── Tuning / Limits ─────────────────────────
PORT=
SEND_GUARD_MAX_PER_MIN=
LID_JID_MAP_MAX=
LID_PHONE_CACHE_MAX=
GROUP_CACHE_TTL_MS=
MESSAGE_CACHE_TTL_MS=
MESSENGER_CACHED_CHATS=
FACE_SIDECAR_URL=http://127.0.0.1:8011
FACE_SIDECAR_TIMEOUT_MS=60000
FACE_CLUSTER_TIMEOUT_MS=300000
FACE_CLUSTER_EPSILON=1.05
FACE_CLUSTER_MIN_POINTS=2
FACE_PRIMARY_PATH_MODE=false
FACE_SCAN_VIDEO=false
FACE_VIDEO_MAX_FRAMES=3
FACE_VIDEO_MIN_SPACING_SEC=2
# Legacy face-api threshold; no longer used by the sidecar-backed indexer.
FACE_MATCH_THRESHOLD=
MEDIA_MAX_MB=
DB_POOL_MAX=
