{
    "env": {
        "node": true,
        "es2022": true
    },
    "extends": ["eslint:recommended", "prettier"],
    "parserOptions": {
        "ecmaVersion": "latest",
        "sourceType": "script"
    },
    "rules": {
        "no-unused-vars": ["warn", { "argsIgnorePattern": "^_" }],
        "no-console": "off",
        "quotes": ["error", "single"],
        "semi": ["error", "always"]
    }
}
